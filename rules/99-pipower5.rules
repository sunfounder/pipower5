# pipower5 uevent rules — email notifications on power events
# Uses systemd-run because udev runs with PrivateNetwork=yes (no DNS)
ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="low_battery", \
  RUN+="/usr/bin/systemd-run --no-block --collect /usr/local/bin/pipower5 send-email low_battery"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="power_disconnected", \
  RUN+="/usr/bin/systemd-run --no-block --collect /usr/local/bin/pipower5 send-email power_disconnected"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="power_restored", \
  RUN+="/usr/bin/systemd-run --no-block --collect /usr/local/bin/pipower5 send-email power_restored"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="battery_activated", \
  RUN+="/usr/bin/systemd-run --no-block --collect /usr/local/bin/pipower5 send-email battery_activated"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="power_insufficient", \
  RUN+="/usr/bin/systemd-run --no-block --collect /usr/local/bin/pipower5 send-email power_insufficient"

# Also log all events to syslog
ACTION=="change", SUBSYSTEM=="pipower5", \
  RUN+="/usr/bin/logger -t pipower5 'PiPower5 event: $env{PIPOWER5_EVENT}'"

# ---------------------------------------------------------------------------
# Allow the pironman5 group to read the pipower5 sysfs attributes without sudo.
# The driver creates /sys/class/pipower5/pipower5/* with root-only modes, so a
# normal user (e.g. the one running the CLI or a production-test script) hits
# PermissionError on charge_current_max etc. Grant group read on every add
# event; the group is created and the user added to it by the pironman5
# installer.
# ---------------------------------------------------------------------------
SUBSYSTEM=="pipower5", ACTION=="add", \
  RUN+="/bin/sh -c 'chmod g+x /sys/class/pipower5 2>/dev/null; chmod -R g+rw /sys/class/pipower5/pipower5 2>/dev/null'"
