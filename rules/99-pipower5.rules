# pipower5 uevent rules — email notifications on power events
# Uses sh -c 'sleep 2' because udev fires before DNS is ready
ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="low_battery", \
  RUN+="/usr/bin/sh -c 'sleep 2; /usr/local/bin/pipower5 send-email low_battery'"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="power_disconnected", \
  RUN+="/usr/bin/sh -c 'sleep 2; /usr/local/bin/pipower5 send-email power_disconnected'"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="power_restored", \
  RUN+="/usr/bin/sh -c 'sleep 2; /usr/local/bin/pipower5 send-email power_restored'"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="battery_activated", \
  RUN+="/usr/bin/sh -c 'sleep 2; /usr/local/bin/pipower5 send-email battery_activated'"

ACTION=="change", SUBSYSTEM=="pipower5", ENV{PIPOWER5_EVENT}=="power_insufficient", \
  RUN+="/usr/bin/sh -c 'sleep 2; /usr/local/bin/pipower5 send-email power_insufficient'"

# Also log all events to syslog
ACTION=="change", SUBSYSTEM=="pipower5", \
  RUN+="/usr/bin/logger -t pipower5 'PiPower5 event: $env{PIPOWER5_EVENT}'"
